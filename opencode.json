{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "question": "allow",
        "publish_code_report": "allow",
        "external_directory": "ask",
        "doom_loop": "allow",
        "edit": "deny",
        "task": "deny",
        "skill": { "*": "deny", "lee-codigo": "allow", "lee-docs": "allow" },
        "bash": {
          "*": "deny",
          "codegraph status *": "allow",
          "codegraph query *": "allow",
          "codegraph explore *": "allow",
          "codegraph context *": "allow",
          "codegraph node *": "allow",
          "codegraph callers *": "allow",
          "codegraph callees *": "allow",
          "codegraph files *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git rev-parse *": "allow",
          "git branch --show-current": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git ls-tree *": "allow",
          "git cat-file *": "allow",
          "git blame *": "allow",
          "git grep *": "allow",
          "markitdown --version": "allow",
          "markitdown \"*\"": "allow"
        }
      }
    }
  }
}
